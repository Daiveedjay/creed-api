    "class-validator": "^0.14.1",
    "cloudinary": "^2.10.0",
    "cookie": "^0.6.0",
    "cookie-parser": "^1.4.7",
    "firebase-admin": "^12.3.1",
    "google-auth-library": "^9.15.1",
    "ioredis": "^5.11.1",
    "nodemailer": "^6.10.1",
    "otp-agent": "^3.0.3",
    "passport-google-oauth20": "^2.0.0",
